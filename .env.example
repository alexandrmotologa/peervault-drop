# PeerVault Drop - Environment Configuration

# Server Port
PORT=8080
HOST=0.0.0.0

# SQLite Database Storage Directory
DATA_DIR=./data

# Telegram Bot Token (from @BotFather)
# If left blank or set to 'mock_token', the bot runs in local mock mode without network polling.
TELEGRAM_BOT_TOKEN=

# Telegram Bot Username (without @)
BOT_USERNAME=peervault_drop_bot

# Telegram Mini App Short Name (configured in BotFather under /newapp)
MINI_APP_SHORT_NAME=app

# Public Web URL for sharing direct web links (defaults to http://localhost:8080 if unset)
PUBLIC_APP_URL=http://localhost:8080

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Secret limits (in bytes, default 65536 = 64KB)
MAX_SECRET_PAYLOAD_BYTES=65536
